{
  "uid": "jobbi-prueba-02",
  "title": "2 · Nominal · 12 TPS",
  "description": "Guía: docs/guia-de-pruebas.md · Punto 10.4 · Escenario 1 Nominal.",
  "tags": [
    "jobbi",
    "pruebas"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
