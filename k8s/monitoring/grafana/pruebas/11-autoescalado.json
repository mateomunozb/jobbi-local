    {
      "type": "timeseries",
      "title": "Cola de Monetización · mensajes esperando vs. umbral para pedir otro Pod",
      "description": "Regla: réplicas = ⌈esperando ÷ 100⌉. Cuando la curva azul pasa la punteada (con ~10 % de tolerancia), el HPA pide un Pod más; la punteada sube con él y la cola empieza a bajar.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(jobbi_sqs_mensajes{cola=\"monetizacion-events-queue\", estado=\"visibles\"})",
          "legendFormat": "mensajes esperando",
          "refId": "A",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(kube_horizontalpodautoscaler_spec_target_metric{namespace=\"aws-local\", horizontalpodautoscaler=\"monetizacion-cola\"}) * scalar(sum(kube_deployment_status_replicas_ready{namespace=\"aws-local\", deployment=\"servicio-monetizacion\"}))",
          "legendFormat": "umbral: réplicas × 100",
          "refId": "B",
          "range": true
